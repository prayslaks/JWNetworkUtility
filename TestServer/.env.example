# Server Log Language (ko / en, Default: en)
LOG_LANG=en

# Token lifetime in seconds (replaces the old main.py CLI options)
ACCESS_TOKEN_EXPIRE_SECONDS=60
REFRESH_TOKEN_EXPIRE_SECONDS=360

# SMTP Configuration (If not set, the authentication code will be output to the server.)

# In case of Gmail: 
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com
